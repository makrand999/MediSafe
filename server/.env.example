# Medac server environment — copy to .env and fill values (never commit .env)
NODE_ENV=development
APP_ENV=development
APP_BUILD_ID=local
HOST=127.0.0.1
PORT=3100
PUBLIC_BASE_URL=https://example.com
TRUST_PROXY=1
DATABASE_URL=postgres://medac:medac@localhost:5432/medac
# Separate role URLs (optional; DATABASE_URL is used by default for all roles)
# DATABASE_MIGRATION_URL=postgres://medac_migration:***@localhost:5432/medac
# DATABASE_WORKER_URL=postgres://medac_worker:***@localhost:5432/medac
# DATABASE_BACKUP_URL=postgres://medac_backup:***@localhost:5432/medac
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
ACCESS_TOKEN_ISSUER=medac
ACCESS_TOKEN_AUDIENCE=medac-api
ACCESS_TOKEN_PRIVATE_KEY_FILE=/opt/medac/secrets/access-private.pem
ACCESS_TOKEN_PUBLIC_KEY_FILE=/opt/medac/secrets/access-public.pem
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_HASH_SECRET=replace-with-256-bit-random-hex
FIELD_ENCRYPTION_KEY_CURRENT=base64-32-byte-key-current
FIELD_ENCRYPTION_KEY_PREVIOUS=
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
CORS_ALLOWED_ORIGINS=https://example.com
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_API_KEY=
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
RXNORM_TIMEOUT_MS=5000
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://api.musespark.example/v1
# Allowlist-only (see server/src/modules/intelligence/model-registry.ts).
# Defaults to muse-spark-1.2-contributor; local Antigravity gateway models such as
# gemini-3.8-flash-high / gemini-3-pro-high are also approved.
MUSE_SPARK_MODEL=muse-spark-1.2-contributor
# Opt in to a plain-http base URL. Only honoured for loopback (http://127.0.0.1 /
# localhost), which is how the self-hosted Antigravity gateway runs.
MUSE_SPARK_ALLOW_HTTP=false
MUSE_SPARK_TIMEOUT_MS=30000
MUSE_SPARK_MAX_OUTPUT_TOKENS=4096
MUSE_SPARK_MAX_AGENT_TURNS=6
MUSE_SPARK_MAX_TOOL_CALLS=12
MUSE_SPARK_DAILY_BUDGET=50
AI_PROMPT_RETENTION_ENABLED=false
AI_CONVERSATION_RETENTION_HOURS=72
AI_PROPOSAL_TTL_MINUTES=30
AI_VISION_MAX_BYTES=5242880
AI_VISION_MAX_PIXELS=8294400
PUSH_PROVIDER_CONFIG_FILE=/opt/medac/secrets/push.json
EXPORT_DIRECTORY=/var/lib/medac/exports
EXPORT_TTL_HOURS=24
LOG_LEVEL=info
METRICS_BIND_ADDRESS=127.0.0.1:3101
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
