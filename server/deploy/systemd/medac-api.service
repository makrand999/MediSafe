[Unit]
Description=Medac API (Fastify)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=medac
Group=medac
WorkingDirectory=/opt/medac/server
ExecStart=/usr/bin/node /opt/medac/server/dist/server.js
Environment=NODE_ENV=production
EnvironmentFile=/opt/medac/env/api.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/medac/exports /var/log/medac
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
