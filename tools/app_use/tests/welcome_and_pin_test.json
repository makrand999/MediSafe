{
  "name": "Medac Welcome and PIN Unlock Flow",
  "steps": [
    {
      "step": 1,
      "action": "launch",
      "package": "com.example.medac",
      "delay_after": 1.0
    },
    {
      "step": 2,
      "action": "tap",
      "target": "Enter PIN",
      "delay_after": 0.8
    },
    {
      "step": 3,
      "action": "assert_text",
      "text": "Enter Security PIN",
      "timeout": 3.0
    },
    {
      "step": 4,
      "action": "tap",
      "target": "Continue",
      "delay_after": 1.0
    },
    {
      "step": 5,
      "action": "assert_text",
      "text": "Daily Progress",
      "timeout": 4.0
    }
  ]
}
